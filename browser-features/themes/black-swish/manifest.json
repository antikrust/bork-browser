{
  "manifest_version": 2,
  "name": "Black Swish",
  "version": "1.0.1",
  "description": "bork built-in theme — Black Swish. Black chrome, with swish.",
  "browser_specific_settings": {
    "gecko": {
      "id": "black-swish@themes.bork"
    }
  },
  "theme": {
    "colors": {
      "frame": "#050506",
      "frame_inactive": "#050506",
      "toolbar": "#0b0b0d",
      "toolbar_text": "#e6e6ea",
      "toolbar_field": "#131317",
      "toolbar_field_text": "#e6e6ea",
      "toolbar_field_border": "#242429",
      "toolbar_field_focus": "#17171c",
      "toolbar_field_border_focus": "#9ca3af",
      "toolbar_top_separator": "#050506",
      "toolbar_bottom_separator": "#1c1c21",
      "tab_background_text": "#a9a9b2",
      "tab_selected": "#17171c",
      "tab_text": "#fbfbfe",
      "tab_line": "#9ca3af",
      "tab_loading": "#9ca3af",
      "popup": "#101014",
      "popup_text": "#e6e6ea",
      "popup_border": "#242429",
      "popup_highlight": "rgba(156,163,175,0.32)",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#0b0b0d",
      "sidebar_text": "#e6e6ea",
      "sidebar_border": "#1c1c21",
      "sidebar_highlight": "rgba(156,163,175,0.32)",
      "sidebar_highlight_text": "#ffffff",
      "icons": "#cfcfd6",
      "icons_attention": "#9ca3af",
      "button_background_hover": "#1d1d23",
      "button_background_active": "#26262d",
      "ntp_background": "#050506",
      "ntp_text": "#e6e6ea"
    },
    "images": {
      "additional_backgrounds": [
        "images/swish.svg"
      ]
    },
    "properties": {
      "additional_backgrounds_alignment": [
        "right top"
      ],
      "additional_backgrounds_tiling": [
        "no-repeat"
      ]
    }
  }
}
