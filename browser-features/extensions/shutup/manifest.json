{
  "manifest_version": 3,
  "name": "SHUT UP — Youpube Tamer",
  "version": "0.2.14",
  "description": "Quiet YouTube: block whole channels from home, search and recommendations, and tame live chat with word and author filters, a one-click SHUT UP button, repeat-offender blocking, and a threaded reading view.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/store.js",
        "src/filters.js",
        "src/threads.js",
        "src/content.js"
      ],
      "css": ["src/ui.css"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "run_at": "document_idle",
      "js": ["src/store.js", "src/filters.js", "src/pages.js"],
      "css": ["src/pages.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["options/options.html"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SHUT UP"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shuddup@bork",
      "update_url": "https://borkbrowser.online/shut-up-updates.json",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
