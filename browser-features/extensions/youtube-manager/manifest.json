{
  "manifest_version": 3,
  "name": "YouTube Manager",
  "version": "0.2.38",
  "description": "Organise YouTube: block channels and users, search and the sidebar, sort your subscriptions into tabs of your own, toggle Shorts, and tame live chat with word and author filters, blocking and a threaded view.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/channels.js",
        "src/store.js",
        "src/filters.js",
        "src/threads.js",
        "src/content.js"
      ],
      "css": [
        "src/ui.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/channels.js",
        "src/store.js",
        "src/filters.js",
        "src/pages.js"
      ],
      "css": [
        "src/pages.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "options/options.html"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Manager",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-manager@bork",
      "update_url": "https://borkbrowser.online/youtube-manager-updates.json",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
