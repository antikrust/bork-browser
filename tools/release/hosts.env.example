# Copy this to hosts.env and fill in your own infra. hosts.env is gitignored, so
# your host names and paths never reach the public repo. Every value here is also
# overridable directly via its BORK_* environment variable. See BUILD.md.

# Linux runtime build host — an SSH alias (from ~/.ssh/config) or user@host.
BORK_BUILD_HOST=your-linux-build-host

# Where the runtime build trees live on each machine.
BORK_MAC_BUILD_DIR=/path/to/bork-build             # on this Mac
BORK_LINUX_BUILD_DIR=/path/to/bork-runtime-build   # on the Linux host
BORK_WIN_BUILD_DIR=/path/to/bork-winbuild          # Windows VM helpers, on the Linux host

# Where release packages are rsynced, and the public URL they end up at.
BORK_WEB_REMOTE=your-web-host:/var/www/example.com/bork/downloads
BORK_SITE_URL=https://example.com/bork/

# The runtime repo that self-built Gecko artifacts are published to, on a
# self-hosted Forgejo/Gitea instance (not GitHub). The repo is public, so
# downloads need no auth; publishing needs a Forgejo token with the
# write:repository scope (Settings -> Applications -> Generate New Token).
BORK_FORGEJO_HOST=git.example.com
BORK_FORGEJO_TOKEN=your_forgejo_write_token
BORK_RUNTIME_REPO=youruser/bork-runtime
BORK_OWN_RUNTIME_REPO=youruser/bork-runtime
