# Copy this to hosts.env and fill in your own infra. hosts.env is gitignored, so
# your host names and paths never reach the public repo. Every value here is also
# overridable directly via its DERP_* environment variable. See BUILD.md.

# Linux runtime build host — an SSH alias (from ~/.ssh/config) or user@host.
DERP_BUILD_HOST=your-linux-build-host

# Where the runtime build trees live on each machine.
DERP_MAC_BUILD_DIR=/path/to/derp-build             # on this Mac
DERP_LINUX_BUILD_DIR=/path/to/derp-runtime-build   # on the Linux host
DERP_WIN_BUILD_DIR=/path/to/derp-winbuild          # Windows VM helpers, on the Linux host

# Where release packages are rsynced, and the public URL they end up at.
DERP_WEB_REMOTE=your-web-host:/var/www/example.com/derp/downloads
DERP_SITE_URL=https://example.com/derp/

# The runtime repo that self-built Gecko artifacts are published to.
DERP_RUNTIME_REPO=youruser/derp-runtime
